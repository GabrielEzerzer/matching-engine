    {
      "id": "cmp-r-ordermap-c",
      "kind": "compare",
      "part": "orders",
      "cand": "r-ordermap-c",
      "pairs": 10,
      "stat": "ns_per_op_min"
    },
    {
      "id": "aa-orders-2",
      "kind": "aa",
      "part": "orders",
      "pairs": 10,
      "stat": "ns_per_op_min"
    },
    {
      "id": "confirm-ordermap",
      "kind": "confirm_best",
      "group": "ordermap",
      "steps": [
        "cmp-r-ordermap-a",
        "cmp-r-ordermap-c"
      ]
    },
    {
      "id": "window-ordermap",
      "kind": "window",
      "group": "ordermap",
      "window": "09:30:00-10:00:00",
      "pairs": 10,
      "stat": "book_mean_ns"
    },
    {
      "id": "golden-ordermap",
      "kind": "golden",
      "group": "ordermap"
    }
  ]
