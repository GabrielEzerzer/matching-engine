{
  "name": "stage3-ordermap",
  "base": "base",
  "cpu": 3,
  "stop_after_min": 630,
  "labels": {
    "base": "m-base",
    "r-ordermap-a": "r-ordermap-a",
    "r-ordermap-c": "r-ordermap-c"
  },
  "steps": [
    {
      "id": "aa-orders",
      "kind": "aa",
      "part": "orders",
