  "steps": [
    {"id": "aa-win", "kind": "aa", "window": "09:30:00-10:00:00", "pairs": 12, "stat": "all_p50_ns"},
    {"id": "cmp-win-inline", "kind": "compare", "window": "09:30:00-10:00:00", "cand": "side-inline", "pairs": 12, "stat": "all_p50_ns"},
    {"id": "cmp-win-slab", "kind": "compare", "window": "09:30:00-10:00:00", "cand": "side-slab", "pairs": 12, "stat": "all_p50_ns"},
    {"id": "aa-side", "kind": "aa", "part": "side", "pairs": 10, "stat": "ns_per_op_min"},
    {"id": "cmp-side-inline", "kind": "compare", "part": "side", "cand": "side-inline", "pairs": 10, "stat": "ns_per_op_min"},
    {"id": "cmp-side-slab", "kind": "compare", "part": "side", "cand": "side-slab", "pairs": 10, "stat": "ns_per_op_min"},
    {"id": "confirm-win", "kind": "confirm_best", "group": "r2", "steps": ["cmp-win-inline", "cmp-win-slab"]},
    {"id": "guard-win", "kind": "window", "group": "r2", "window": "09:30:00-10:00:00", "pairs": 10, "stat": "book_mean_ns"},
