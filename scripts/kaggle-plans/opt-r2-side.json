{
  "name": "opt-r2-side",
  "base": "base",
  "cpu": 3,
  "stop_after_min": 630,
  "labels": {
    "base": "opt-base",
    "side-inline": "opt-r2-side-inline",
    "side-slab": "opt-r2-side-slab"
